# --- Telegram ---
BOT_TOKEN=123456:REPLACE_ME

# --- Database (async driver для приложения и для alembic) ---
DATABASE_URL=postgresql+asyncpg://burnfat:burnfat@db:5432/burnfat

# --- AI: NLU (разбор текста) + STT (голос) ---
# Расчёт КБЖУ всегда делает приложение. LLM только извлекает сущности и даёт
# первичную оценку плотности продукта (используется ТОЛЬКО при первом появлении продукта).
# openai | anthropic (NFR-6, D-41). Голос — всегда Whisper: OPENAI_API_KEY нужен и при anthropic.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-5.1
OPENAI_STT_MODEL=whisper-1
# Claude — только при LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Модели по маршрутам; пусто — умолчание провайдера (OpenAI: OPENAI_MODEL / gpt-5.1,
# Anthropic: claude-opus-5-5). Модель чужого провайдера — бот не стартует.
NLU_MODEL=
VISION_MODEL=
COACH_MODEL=
# Глубина рассуждений Claude: low | medium | high | xhigh | max
NLU_EFFORT=low
VISION_EFFORT=low
COACH_EFFORT=medium
# true — выключить рассуждения на разборе и фото (Sonnet/Haiku 5.5; у Opus 5.5 не выключаются)
CLAUDE_THINKING_OFF=false
# true — локальный детерминированный парсер без вызовов LLM (для smoke-теста/CI)
USE_FAKE_NLU=false

# --- Поведение ---
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_GOAL_KCAL=2000
DEFAULT_GOAL_PROTEIN=150
DEFAULT_GOAL_FAT=65
DEFAULT_GOAL_CARB=250
# Порог уверенности для автосохранения (используется в M2 при уточняющих вопросах)
CONFIDENCE_AUTO_THRESHOLD=0.6
LOG_LEVEL=INFO
DB_ECHO=false

# --- Postgres (для docker-compose) ---
POSTGRES_USER=burnfat
POSTGRES_PASSWORD=burnfat
POSTGRES_DB=burnfat
