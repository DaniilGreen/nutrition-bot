# --- Telegram ---
BOT_TOKEN=123456:REPLACE_ME

# --- Database (async driver для приложения и для alembic) ---
DATABASE_URL=postgresql+asyncpg://burnfat:burnfat@db:5432/burnfat

# --- AI: NLU (разбор текста) + STT (голос) ---
# Расчёт КБЖУ всегда делает приложение. LLM только извлекает сущности и даёт
# первичную оценку плотности продукта (используется ТОЛЬКО при первом появлении продукта).
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-4.1
OPENAI_STT_MODEL=whisper-1
# true — локальный детерминированный парсер без вызовов LLM (для smoke-теста/CI)
USE_FAKE_NLU=false

# --- Поведение ---
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_GOAL_KCAL=2000
DEFAULT_GOAL_PROTEIN=150
DEFAULT_GOAL_FAT=65
DEFAULT_GOAL_CARB=250
# Порог уверенности для автосохранения (используется в M2 при уточняющих вопросах)
CONFIDENCE_AUTO_THRESHOLD=0.6
LOG_LEVEL=INFO
DB_ECHO=false

# --- Postgres (для docker-compose) ---
POSTGRES_USER=burnfat
POSTGRES_PASSWORD=burnfat
POSTGRES_DB=burnfat
